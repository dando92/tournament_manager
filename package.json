{
  "name": "tournament-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently --names backend,frontend --prefix-colors blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev:localdev --workspace=tournament_manager_backend",
    "dev:frontend": "npm run dev:local --workspace=tournament-viewer",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=tournament_manager_backend",
    "test:unit": "npm run test --workspace=tournament_manager_backend -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace=tournament_manager_backend -- --runInBand",
    "verify": "npm run lint && npm run test:unit && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
