{
  "name": "tournament-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/application",
    "packages/eventing",
    "apps/backend",
    "apps/processor",
    "apps/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently --names backend,processor,frontend --prefix-colors blue,cyan,magenta \"npm run dev:backend\" \"npm run dev:processor\" \"npm run dev:frontend\"",
    "dev:dependencies": "docker compose up --detach --wait postgres redis migrations",
    "dev:backend": "npm run start:dev:localdev --workspace=tournament_manager_backend",
    "dev:processor": "npm run start:dev --workspace=@tournament-manager/processor",
    "dev:frontend": "npm run dev:local --workspace=tournament-viewer",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=tournament_manager_backend",
    "test:unit": "npm run test --workspace=tournament_manager_backend -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace=tournament_manager_backend -- --runInBand",
    "test:integration": "npm run test:integration --workspace=tournament_manager_backend",
    "verify": "npm run lint && npm run test:unit && npm run test:e2e && npm run build",
    "local:up": "docker compose up --build --detach --wait",
    "local:status": "docker compose ps && node scripts/local-status.mjs",
    "local:logs": "docker compose logs --follow --tail=200",
    "local:down": "docker compose down --remove-orphans",
    "local:reset": "docker compose down --volumes --remove-orphans && docker compose up --build --detach --wait",
    "verify:local": "npm run test:integration && npm run test:e2e && node scripts/verify-local.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
