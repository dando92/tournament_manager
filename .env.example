AUTH_MODE=local
LOCAL_API_KEY=change-me
JWT_SECRET=change-me
PORT=3000
CORS_ORIGINS=http://localhost,http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=tournament_manager
DATABASE_PASSWORD=tournament_manager
DATABASE_NAME=tournament_manager
DATABASE_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EVENT_STREAM=tournament-manager.events
EVENT_CONSUMER_GROUP=tournament-manager-backend-v1
