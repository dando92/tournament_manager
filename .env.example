# Bootstraps the first administrator account when it does not already exist.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
PORT=3000
PROCESSOR_PORT=3001
SYNCSTART_PORT=3002
CORS_ORIGINS=http://localhost,http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=tournament_manager
DATABASE_PASSWORD=tournament_manager
DATABASE_NAME=tournament_manager
DATABASE_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional. Set for a hosted Redis that requires credentials or TLS; it overrides REDIS_HOST and REDIS_PORT.
#REDIS_URL=rediss://user:password@host:6380
INTERNAL_SERVICE_TOKEN=change-me-internal
SYNCSTART_INTERNAL_URL=http://127.0.0.1:3002
API_INTERNAL_URL=http://127.0.0.1:3000
INTERNAL_HTTP_TIMEOUT_MS=5000
LIVE_EVENT_CHANNEL=tournament-manager.live
OUTBOX_RELAY_IDLE_INTERVAL_MS=200

POSTGRES_PORT=5432
API_PORT=3000
FRONTEND_PORT=80
LOCAL_FIXTURE_TOURNAMENT_NAME=Local E2E Tournament
# Leave empty for a fixture without SyncStart. Set a host or remote WebSocket URL, or use ws://syncstart-simulator:19000 with --profile simulator.
LOCAL_FIXTURE_SYNCSTART_URL=

# Legacy ITGmania bridge, started by `npm run local_sync:up`. The tournament's
# SyncStart URL is ws://legacy-syncstart-bridge:1337 when the bridge runs in
# Compose, or ws://host.docker.internal:1337 when it runs on the host through
# `npm run local_sync:bridge`.
LEGACY_BRIDGE_UDP_PORT=53000
LEGACY_BRIDGE_WS_PORT=1337
LEGACY_BRIDGE_LOBBY_CODE=BRDG
LEGACY_BRIDGE_LOBBY_PASSWORD=
# Optional. Comma-separated cabinet addresses; empty accepts every source on the segment.
LEGACY_BRIDGE_UDP_ALLOWED_SOURCES=
LEGACY_BRIDGE_FINAL_GRACE_MS=1500
LEGACY_BRIDGE_FINAL_TIMEOUT_MS=20000
LEGACY_BRIDGE_LOG_LEVEL=info

STARTGG_API_URL=https://api.start.gg/gql/alpha
STARTGG_PER_PAGE=64
STARTGG_MIN_INTERVAL_MS=1000

PUBLIC_API_URL=http://localhost:3000/
PUBLIC_REALTIME_URL=http://localhost:3003/
