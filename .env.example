AUTH_MODE=local
LOCAL_API_KEY=change-me
JWT_SECRET=change-me
PORT=3000
PROCESSOR_PORT=3001
SYNCSTART_PORT=3002
CORS_ORIGINS=http://localhost,http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=tournament_manager
DATABASE_PASSWORD=tournament_manager
DATABASE_NAME=tournament_manager
DATABASE_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EVENT_STREAM=tournament-manager.events
EVENT_CONSUMER_GROUP=tournament-manager-processor
SYNCSTART_COMMAND_STREAM=tournament-manager.syncstart.commands
SYNCSTART_CONSUMER_GROUP=tournament-manager-syncstart
SYNCSTART_COMMAND_TIMEOUT_MS=15000
INTERNAL_SERVICE_TOKEN=change-me-internal
SYNCSTART_INTERNAL_URL=http://127.0.0.1:3002
API_INTERNAL_URL=http://127.0.0.1:3000
INTERNAL_HTTP_TIMEOUT_MS=5000
LIVE_EVENT_CHANNEL=tournament-manager.live
OUTBOX_RELAY_IDLE_INTERVAL_MS=200
EVENT_CONSUMER_BLOCK_MS=500
EVENT_RECLAIM_IDLE_MS=250
TOURNAMENT_TRANSPORT_RETENTION_DAYS=10
TRANSPORT_RETENTION_SWEEP_INTERVAL_MS=21600000
TRANSPORT_RETENTION_BATCH_SIZE=1000

POSTGRES_PORT=5432
API_PORT=3000
FRONTEND_PORT=80
LOCAL_FIXTURE_TOURNAMENT_NAME=Local E2E Tournament
# Leave empty for a fixture without SyncStart. Set a host or remote WebSocket URL, or use ws://syncstart-simulator:19000 with --profile simulator.
LOCAL_FIXTURE_SYNCSTART_URL=

STARTGG_API_URL=https://api.start.gg/gql/alpha
STARTGG_PER_PAGE=64
STARTGG_MIN_INTERVAL_MS=1000

PUBLIC_API_URL=http://localhost:3000/
PUBLIC_REALTIME_URL=http://localhost:3003/
PUBLIC_AUTH_MODE=local
