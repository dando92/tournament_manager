{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@backend/(.*)$": "<rootDir>/../src/$1",
    "^@processor/(.*)$": "<rootDir>/../../processor/src/$1",
    "^@test/(.*)$": "<rootDir>/$1",
    "^@auth/(.*)$": "<rootDir>/../src/auth/$1",
    "^@backwards-compat/(.*)$": "<rootDir>/../src/backwards-compat/$1",
    "^@bracket/(.*)$": "<rootDir>/../src/tournament/bracket/$1",
    "^@match/(.*)$": "<rootDir>/../src/tournament/match/$1",
    "^@match-manager/(.*)$": "<rootDir>/../src/match-manager/$1",
    "^@persistence/(.*)$": "<rootDir>/../src/persistence/$1",
    "^@player/(.*)$": "<rootDir>/../src/tournament/player/$1",
    "^@tournament/(.*)$": "<rootDir>/../src/tournament/$1",
    "^@account/(.*)$": "<rootDir>/../src/account/$1"
  }
}
