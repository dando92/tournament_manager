{
  "name": "@tournament-manager/processor",
  "version": "0.0.1",
  "private": true,
  "main": "dist/processor/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start:prod": "node dist/processor/src/main.js",
    "start:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/typeorm": "^11.0.1",
    "@tournament-manager/application": "0.0.1",
    "@tournament-manager/contracts": "0.0.1",
    "@tournament-manager/eventing": "0.0.1",
    "pg": "^8.13.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tournament_manager_backend": "0.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
