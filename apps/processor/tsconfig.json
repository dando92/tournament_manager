{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["../backend/src/*"],
      "@processor/*": ["src/*"],
      "@auth/*": ["../backend/src/auth/*"],
      "@bracket/*": ["../backend/src/tournament/bracket/*"],
      "@match/*": ["../backend/src/tournament/match/*"],
      "@persistence/*": ["../backend/src/persistence/*"],
      "@player/*": ["../backend/src/tournament/player/*"],
      "@tournament/*": ["../backend/src/tournament/*"],
      "@account/*": ["../backend/src/account/*"]
    },
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.ts"]
}
