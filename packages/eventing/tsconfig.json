{
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@eventing/*": ["src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2021"
  },
  "include": ["src/**/*.ts"]
}
